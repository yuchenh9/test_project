 using UnityEngine;
using Systems.Collections.Generic;
 public static class lerpValuesFromArray{

 
 public static List<float> assignValues(int n,float[] valueData)
    {
        int length=valueData.Length;
        List<float> toReturn=new List<float>();
        for(int i =0;i<n;i++){
            float t=(float)i/(n-1);//
            int a=(int)Math.Floor((length-1)*t);
            int b=(int)Math.Ceiling((length-1)*t);
            float decimalpart=(length-1)*t-a;
            a=Math.Max(0,Math.Min(length-1,a));//
            b=Math.Min(length-1,b);
            //Console.WriteLine(a);
            //Console.WriteLine(b);
            toReturn.Add(lerpValue(decimalpart,(float)valueData[a],(float)valueData[b]));//
        }
        return toReturn;
    }
 }